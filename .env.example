# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (postgresql://user:pass@ep-xyz.neon.tech/spex?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing session tokens (must be at least 32 characters long)
JWT_SECRET="spex-production-secret-jwt-key-change-this-32chars"



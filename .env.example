# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL of the app on Render (e.g., https://spex-platform.onrender.com)
APP_URL="https://spex-platform.onrender.com"

# DATABASE_URL: Neon PostgreSQL connection string (postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing session tokens (must be at least 32 characters long)
JWT_SECRET="spex-production-secret-jwt-key-change-this-32chars"

# RESEND_API_KEY: API key from Resend (https://resend.com) for sending emails
RESEND_API_KEY="re_123456789"

# EMAIL_FROM: Verified sender email address in Resend
EMAIL_FROM="SPEX <onboarding@resend.dev>"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: For Google OAuth Login
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"



